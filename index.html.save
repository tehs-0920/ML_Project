        #result {
            margin-top: 25px;
            padding: 20px;
            background: #eef7ee;
            border-radius: 8px;
            text-align: center;
            display: none;
        }

        #crop {
            font-size: 24px;
            font-weight: bold;
        }

        #error {
            margin-top: 15px;
            color: red;
            text-align: center;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>🌱 Crop Recommendation System</h1>

    <p class="subtitle">
        Enter soil and environmental conditions to get a crop recommendation.
    </p>

    <label>Nitrogen (N)</label>
    <input type="number" id="N" step="any" required>

    <label>Phosphorus (P)</label>
    <input type="number" id="P" step="any" required>

    <label>Potassium (K)</label>
    <input type="number" id="K" step="any" required>

    <label>Temperature</label>
    <input type="number" id="temperature" step="any" required>

    <label>Humidity</label>
    <input type="number" id="humidity" step="any" required>

    <label>Soil pH</label>
    <input type="number" id="ph" step="any" required>

    <label>Rainfall</label>
    <input type="number" id="rainfall" step="any" required>

    <button onclick="recommendCrop()">
        Recommend Crop
    </button>

    <div id="result">
        <div>Recommended Crop</div>
        <div id="crop"></div>
        <div id="confidence"></div>
    </div>

    <div id="error"></div>

</div>


<script>

